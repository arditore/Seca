<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The call history, and the contacts it is matched against. No INTERNET
         permission, ever: the app cannot send a call history anywhere. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Asked the first time the user deletes a call from the history. -->
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Asked the first time the user places a call. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Granted with the phone-app role: names the SIM a call goes through. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Seca Contacts' profiles, readable only by apps signed with the same key. -->
    <uses-permission android:name="com.seca.permission.READ_PROFILES" />

    <!-- The call screen: its notification, its full screen when the phone is locked,
         and the proximity sensor that darkens the screen against the ear. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Lets Seca Contacts place a call in one tap through PlaceCallActivity. Only apps
         signed with the same key get it, so no other app can call without CALL_PHONE. -->
    <permission
        android:name="com.seca.permission.PLACE_CALLS"
        android:label="Passer des appels avec Seca Téléphone"
        android:protectionLevel="signature" />

    <!-- Not required: without a SIM the history and the contacts still show, and
         calls simply cannot be placed. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- The bottom bar opens the other Seca apps, or the system's messaging app until
         Seca Messages exists. -->
    <queries>
        <package android:name="com.seca.contacts" />
        <package android:name="com.seca.messages" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Seca Téléphone"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecaPhone">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SecaPhone"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open the keypad", from any app, with or without a number. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlaceCallActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="com.seca.permission.PLACE_CALLS"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.seca.phone.action.CALL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- The call screen lives in its own task: it shows over the lock screen and
             never mixes with the app's own back stack. -->
        <activity
            android:name=".call.InCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity="com.seca.phone.incall"
            android:theme="@style/Theme.SecaPhone"
            android:turnScreenOn="true" />

        <!-- Android hands every call to this service once Seca Téléphone is the default
             phone app. Only the system may bind to it. -->
        <service
            android:name=".call.SecaInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <!-- False: Android keeps playing the ringtone and the vibration itself. -->
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- "Refuser" and "Raccrocher" in the call notifications; this app's only. -->
        <receiver
            android:name=".call.CallActionReceiver"
            android:exported="false" />
    </application>

</manifest>
