<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read to list contacts; write is asked only the first time the user saves a
         change. No INTERNET permission, ever — the app cannot send a contact anywhere. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Seca apps signed with the same key read the profiles through ProfilesProvider;
         no other app can. -->
    <permission
        android:name="com.seca.permission.READ_PROFILES"
        android:label="Lire les profils Seca"
        android:protectionLevel="signature" />

    <!-- The bottom bar opens the other Seca apps when they are installed. -->
    <queries>
        <package android:name="com.seca.phone" />
        <package android:name="com.seca.messages" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Seca Contacts"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecaContacts">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SecaContacts"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".ProfilesProvider"
            android:authorities="com.seca.contacts.profiles"
            android:exported="true"
            android:permission="com.seca.permission.READ_PROFILES" />
    </application>

</manifest>
