<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read to list contacts; write is asked only the first time the user saves a
         change. No INTERNET permission, ever — the app cannot send a contact anywhere. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Fingerprint or phone code, only when the owner turns the app lock on. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- "Call" places the call in one tap through Seca Phone, when it is signed with the same
         key. Declared here too: Android grants it only if it was defined when this app was
         installed, so it holds whether Seca Phone is installed before or after. -->
    <permission
        android:name="com.seca.permission.PLACE_CALLS"
        android:label="@string/permission_place_calls"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.seca.permission.PLACE_CALLS" />
    <!-- Asked only when the user opens "My card" and chooses to read the SIM numbers. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Seca apps signed with the same key read the profiles through ProfilesProvider;
         no other app can. -->
    <permission
        android:name="com.seca.permission.READ_PROFILES"
        android:label="@string/permission_read_profiles"
        android:protectionLevel="signature" />

    <!-- The bottom bar opens the other Seca apps when they are installed. -->
    <queries>
        <package android:name="com.seca.phone" />
        <package android:name="com.seca.messages" />
    </queries>

    <!-- One notification only, and only when a backup that writes itself could not be
         written: a backup that stops in silence is discovered on the day it was needed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- So a backup set up months ago goes on being written after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecaContacts">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SecaContacts"
            android:windowSoftInputMode="adjustResize">
            <!-- "Add this number to the contacts", from Seca Phone or any app. -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT_OR_EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <!-- "Show this contact". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
            </intent-filter>
            <!-- "Open this contact card": one arriving in a message, or sitting in a folder. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/directory" />
            </intent-filter>
            <!-- "Pick one contact", from Seca Messages or any app: the list answers and closes,
                 handing back that one contact and the right to read it. -->
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/phone_v2" />
                <data android:mimeType="vnd.android.cursor.dir/email_v2" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/phone_v2" />
                <data android:mimeType="vnd.android.cursor.item/email_v2" />
            </intent-filter>
        </activity>
        <!-- The launcher entry, named either way (#33). Exactly one of these is enabled at
             a time; MainActivity itself is never disabled, because notifications and the
             other Seca apps start it by name and a disabled component cannot be started. -->
        <activity-alias
            android:name=".LauncherSeca"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherPlain"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name_plain"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Hands a shared contact's .vcf to the app the user picks, and to no other. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.seca.contacts.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <provider
            android:name=".ProfilesProvider"
            android:authorities="com.seca.contacts.profiles"
            android:exported="true"
            android:permission="com.seca.permission.READ_PROFILES" />

        <!-- This app's part of the suite's backup, for the Seca apps signed with the same key only. -->
        <provider
            android:name=".ContactsSuiteBackup"
            android:authorities="com.seca.contacts.backup"
            android:exported="true"
            android:permission="com.seca.permission.BACKUP" />

        <!-- Backups that write themselves: the alarm that writes one, and the restart or update
             that would otherwise have quietly ended them. -->
        <receiver
            android:name="com.seca.core.suite.AutoBackupReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
