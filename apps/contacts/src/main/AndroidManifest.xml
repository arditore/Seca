<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read to list contacts; write is asked only the first time the user saves a
         change. No INTERNET permission, ever — the app cannot send a contact anywhere. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Fingerprint or phone code, only when the owner turns the app lock on. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- "Appeler" calls in one tap through Seca Phone, when it is signed with the same key. -->
    <uses-permission android:name="com.seca.permission.PLACE_CALLS" />
    <!-- Asked only when the user opens "Ma fiche" and chooses to read the SIM numbers. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Seca apps signed with the same key read the profiles through ProfilesProvider;
         no other app can. -->
    <permission
        android:name="com.seca.permission.READ_PROFILES"
        android:label="Lire les profils Seca"
        android:protectionLevel="signature" />

    <!-- The bottom bar opens the other Seca apps when they are installed. -->
    <queries>
        <package android:name="com.seca.phone" />
        <package android:name="com.seca.messages" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Seca Contacts"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecaContacts">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SecaContacts"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Add this number to the contacts", from Seca Phone or any app. -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT_OR_EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <!-- "Show this contact". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
            </intent-filter>
        </activity>

        <!-- Hands a shared contact's .vcf to the app the user picks, and to no other. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.seca.contacts.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <provider
            android:name=".ProfilesProvider"
            android:authorities="com.seca.contacts.profiles"
            android:exported="true"
            android:permission="com.seca.permission.READ_PROFILES" />

        <!-- This app's part of the suite's backup, for the Seca apps signed with the same key only. -->
        <provider
            android:name=".ContactsSuiteBackup"
            android:authorities="com.seca.contacts.backup"
            android:exported="true"
            android:permission="com.seca.permission.BACKUP" />
    </application>

</manifest>
