<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- To ask, once Seca Link is on, that Android let the app listen in the background without
         a notification: a phone without Google has no push service to wake it instead. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Text messages: read, receive and send. They never go anywhere but to the person
         they are written to. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Seca Link only, once the owner turns it on: public keys and encrypted envelopes to
         the Nostr relays they list. Seca Contacts and Seca Telephone never get this. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Multimedia messages come later, but the default messaging app must accept them. -->
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Fingerprint or phone code, only when the owner turns the app lock on. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scheduled messages: sent on the minute when the owner allows it, and set again after a restart. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Seca Link, while it is on, keeps listening to its relays in a foreground service
         with a quiet notification: a phone without Google has no push service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Seca Contacts profiles, and one-tap calls through Seca Telephone: only apps signed
         with the same key hold these. -->
    <uses-permission android:name="com.seca.permission.READ_PROFILES" />
    <uses-permission android:name="com.seca.permission.PLACE_CALLS" />

    <!-- Lets Seca Téléphone hand over the text of "Refuser et répondre". Declared by both apps,
         so it holds whichever is installed first; only apps signed with the same key get it. -->
    <permission
        android:name="com.seca.permission.SEND_MESSAGES"
        android:label="Envoyer des messages avec Seca Messages"
        android:protectionLevel="signature" />
    <!-- The camera, asked only when the owner scans a contact's safety number; no image is kept. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The microphone, asked only when the owner records a voice message for Seca Link. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <package android:name="com.seca.contacts" />
        <package android:name="com.seca.phone" />
        <!-- Orbot, when the owner routes Seca Link through Tor: to see it is there and ask it to start. -->
        <package android:name="org.torproject.android" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Seca Messages"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecaMessages">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SecaMessages"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Write to a number, from any app or link. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Only the default messaging app receives messages; it must also store them. -->
        <receiver
            android:name=".sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".sms.MmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Sent status, quick reply and mark as read, from this app only. -->
        <receiver
            android:name=".sms.MessageActionReceiver"
            android:exported="false" />

        <!-- The text of "Refuser et répondre", from Seca Téléphone only: sent at once. -->
        <receiver
            android:name=".sms.QuickReplyReceiver"
            android:exported="true"
            android:permission="com.seca.permission.SEND_MESSAGES">
            <intent-filter>
                <action android:name="com.seca.messages.action.QUICK_REPLY" />
            </intent-filter>
        </receiver>

        <!-- Scheduled messages get their alarms back after a restart or an update. -->
        <receiver
            android:name=".sms.ScheduleRestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Seca Link invitations: data SMS on their own port, which phones without Seca ignore. -->
        <receiver
            android:name=".sms.LinkHandshakeReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.intent.action.DATA_SMS_RECEIVED" />
                <data
                    android:host="localhost"
                    android:port="19734"
                    android:scheme="sms" />
            </intent-filter>
        </receiver>

        <!-- Seca Link listening to its relays, only while Seca Link is on. -->
        <service
            android:name=".link.LinkService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- Declining a call with a text, from the call screen. -->
        <service
            android:name=".sms.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>
    </application>

</manifest>
